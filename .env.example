# ================== IOC Pulse – Environment ==================

# ----- REQUIRED: Gemini API key -----
# Get one free: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here

# ----- REQUIRED: primary Gemini model (no hardcoded default) -----
# Example: gemini-3.1-flash-lite
GEMINI_MODEL_NAME=

# ----- OPTIONAL: fallback chain for 503/429 overloads -----
# Comma-separated. Leave empty for no fallbacks.
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=

# ----- Local SQLite (auto-created) -----
# Docker overrides this to /app/data/ioc_pulse.db via bind mount.
DB_PATH=./data/ioc_pulse.db

# ----- LLM knobs -----
LLM_BATCH_SIZE=5
LLM_MAX_NEW_TOKENS=2048
LLM_TEMPERATURE=0.0

# ----- Logging -----
LOG_LEVEL=INFO
DEBUG_WRITE_FILES=false

# ----- Autonomous daily scheduler -----
ENABLE_SCHEDULER=true
SCHEDULER_HOUR_UTC=4

# ----- Optional: NVD API key (removes rate limits) -----
# Get one free: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=