# ================== IOC Pulse – Environment ==================
# Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# Local SQLite database (created automatically on first run)
DB_PATH=./data/ioc_pulse.db

# Optional knobs
LLM_BATCH_SIZE=5
LLM_MAX_NEW_TOKENS=2048
LLM_TEMPERATURE=0.0
LOG_LEVEL=INFO
DEBUG_WRITE_FILES=false

# ---- Phase 2: Autonomous scheduling ----
# Set to "false" to disable the in-process daily ingestion scheduler.
ENABLE_SCHEDULER=true
# Hour (0–23) in UTC at which to run the daily ingestion job.
SCHEDULER_HOUR_UTC=4

# ---- Optional: CVE Enrichment (Phase 3) ----
# Leave blank to use the NVD API unauthenticated (5 req / 30 s).
# Set a free API key for 50 req / 30 s + faster multi-CVE enrichment.
# Request one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=